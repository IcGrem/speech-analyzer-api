server {
    if ($host = ssa.ai-check.ru) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name ssa.ai-check.ru;
    return 301 https://$server_name$request_uri;


}

server {
    listen 443 ssl http2;
    server_name ssa.ai-check.ru;
    ssl_certificate /etc/letsencrypt/live/ssa.ai-check.ru/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ssa.ai-check.ru/privkey.pem; # managed by Certbot

    charset utf-8;

    # ===== Vue 3 SPA =====
    location / {
        root /var/www/html;
        index index.html;
        try_files $uri /index.html;
    }

    # Кэширование статики
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|ttf|svg)$ {
        root /var/www/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ===== Проксирование на FastAPI =====
    location /api/v1/ {
        proxy_pass http://unix:/home/<имя-пользователя>/speech-analyzer-api/run/gunicorn.sock;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Таймауты для загрузки файлов
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location /docs {
        proxy_pass http://unix:/home/<имя-пользователя>/speech-analyzer-api/run/gunicorn.sock;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Таймауты для загрузки файлов
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location /openapi.json {
        proxy_pass http://unix:/home/<имя-пользователя>/speech-analyzer-api/run/gunicorn.sock;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ===== Внутренние файлы =====
    location /speech-data/ {
        internal;
        alias /home/sa-admin/speech-analyzer-api/speech-data/;
    }

}

